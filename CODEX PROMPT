def load_pretrained(self):
    """Nixtla Chronos-T5 pre-trained para previsão 1min crypto"""
    from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
    model_name = "nixtla/chronos-t5-small"  # Ou large para mais precisão
    self.tokenizer = AutoTokenizer.from_pretrained(model_name)
    self.model = AutoModelForSeq2SeqLM.from_pretrained(model_name)

def forecast(self, df_ohlcv, horizon=):[1][2]
    """Previsão preço próximo 5/15/60min"""
    # Converter OHLCV para formato Chronos (log returns)
    prices = np.log1p(df_ohlcv['close'].tail(512).values)
    predictions = {}
    
    for h in horizon:
        # Tokenizar sequência
        inputs = self.tokenizer(prices.astype(np.float32), 
                              return_tensors="pt", padding=True)
        
        # Gerar previsão
        with torch.no_grad():
            outputs = self.model.generate(**inputs, max_length=h+10)
        
        pred_prices = self.tokenizer.decode(outputs, skip_special_tokens=True)
        pred_logret = np.fromstring(pred_prices.replace('[PAD]', ''), sep=' ')
        predictions[f'{h}min'] = np.expm1(pred_logret[-h:].mean())  # % change
    
    return predictions

