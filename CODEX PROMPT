class RiskManager:
def init(self):
self.daily_pnl = 0
self.daily_trades = 0
self.max_daily_loss = -0.02 # -2%
self.correlation_exposure = {}
self.circuit_breakers = []
text
def check_risk_limits(self, symbol, proposed_size_pct, decision):
    """5 camadas de proteção"""
    checks = {}
    
    # 1. Daily loss limit
    if self.daily_pnl < self.max_daily_loss:
        checks['daily_loss'] = False
        return checks
    
    # 2. Max trades per day (20)
    if self.daily_trades >= 20:
        checks['trade_limit'] = False
        return checks
    
    # 3. Position sizing dinâmico
    var_risk = decision.get('var_risk', 0.02)
    max_size = min(proposed_size_pct, 0.005 / var_risk)  # 0.5% / VaR
    
    # 4. Correlation limit (max 30% same direction)
    corr_exposure = self.correlation_exposure.get(symbol, 0)
    if corr_exposure > 0.3:
        max_size *= 0.5
    
    # 5. Regime-aware sizing
    regime = decision.get('regime', 'range')
    regime_multipliers = {'trending': 1.5, 'range': 0.7, 'choppy': 0.3}
    max_size *= regime_multipliers.get(regime, 1.0)
    
    # 6. Anomaly adjustment
    anomaly_risk = decision.get('anomaly_risk', 1.0)
    max_size *= anomaly_risk
    
    checks['approved_size'] = max(max_size, 0.001)  # Min 0.1%
    checks['all_clear'] = True
    
    return checks

def update_exposure(self, symbol, side, size_pct, pnl_pct):
    """Track correlation + daily metrics"""
    self.daily_pnl += pnl_pct * size_pct
    self.daily_trades += 1
    
    direction = 1 if side == 'buy' else -1
    self.correlation_exposure[symbol] = self.correlation_exposure.get(symbol, 0) + direction * size_pct
    
    # Circuit breaker triggers
    if self.daily_pnl < -0.015:  # -1.5%
        self.circuit_breakers.append('daily_loss_1.5')
        print("🚨 CIRCUIT BREAKER: Daily loss -1.5%")
    
    # Regime detection update
    self.update_market_regime(symbol, pnl_pct)

def update_market_regime(self, symbol, pnl_pct):
    """HMM stub para regime detection"""
    recent_pnls = [t['pnl_pct'] for t in self.ensemble.self_learning.trade_history[-20:]]
    if np.mean(recent_pnls) > 0.002:
        return 'trending'
    elif np.std(recent_pnls) > 0.01:
        return 'choppy'
    else:
        return 'range'

