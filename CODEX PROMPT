    """Backtest 1 ano BTC/ETH/XRP vs BUY&HOLD"""
    ensemble = TradingEnsemble()
    db = TraderDatabase()
    
    results = {'ai_trades': [], 'buy_hold': []}
    
    for symbol in Config.ASSETS:
        print(f"🔄 Backtesting {symbol}...")
        
        # Histórico 1 ano 1h
        df = ensemble.data_engine.get_ohlcv(symbol, timeframe='1h', limit=8760)
        
        # Simula trades ensemble
        for i in range(100, len(df)):
            features = ensemble.data_engine.get_features_from_df(df.iloc[:i])
            decision = ensemble.predict(symbol)
            
            if decision['signal'] != 'HOLD':
                # Simula PnL 1h
                entry_price = df.iloc[i]['close']
                exit_price = df.iloc[min(i+6, len(df)-1)]['close']  # 6h hold
                pnl = (exit_price - entry_price) / entry_price
                
                results['ai_trades'].append({
                    'symbol': symbol, 'pnl': pnl, 'timestamp': df.index[i]
                })
        
        # Buy & Hold benchmark
        bh_pnl = (df.iloc[-1]['close'] - df.iloc[0]['close']) / df.iloc[0]['close']
        results['buy_hold'].append({'symbol': symbol, 'pnl': bh_pnl})
    
    # Métricas finais
    ai_pnls = [t['pnl'] for t in results['ai_trades']]
    sharpe = np.mean(ai_pnls) / np.std(ai_pnls) * np.sqrt(365*24)
    
    print(f"\n📊 BACKTEST RESULTADOS:")
    print(f"Sharpe Ratio AI: {sharpe:.2f}")
    print(f"Trades simulados: {len(ai_pnls)}")
    print(f"AI vs Buy&Hold: {np.mean(ai_pnls):.1%} vs {np.mean([b['pnl'] for b in results['buy_hold']]):.1%}")
    
    return sharpe > 2.0  # Pass/Fail

if __name__ == "__main__":
    success = run_backtest()
    print("✅ BACKTEST PASSADO" if success else "❌ BACKTEST FALHOU")

