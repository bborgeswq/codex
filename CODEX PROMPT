class ExecutionEngine:
    def __init__(self):
        self.binance = ccxt.binance({
            'apiKey': Config.BINANCE_TESTNET_KEY,
            'secret': Config.BINANCE_TESTNET_SECRET,
            'sandbox': True,
            'enableRateLimit': True,
            'options': {'defaultType': 'future'}
        })
        self.positions = {}
        self.balance = Config.INITIAL_CAPITAL_USD
        self.open_orders = {}
    
    def get_balance(self):
        """USDT disponível testnet"""
        try:
            balance = self.binance.fetch_balance()
            return balance['USDT']['free']
        except:
            return self.balance
    
    def calculate_position_size(self, price, risk_pct, stop_distance_pct):
        """Kelly Criterion + max risk"""
        balance = self.get_balance()
        risk_usd = balance * Config.MAX_RISK_PER_TRADE * risk_pct
        size_usd = risk_usd / abs(stop_distance_pct)
        return min(size_usd / price, balance * 0.02)  # Max 2% capital
    
    def place_order(self, symbol, side, size_usd, price, stop_loss, target):
        """Ordem market + OCO stop/target"""
        try:
            size = size_usd / price
            
            # Market order principal
            order = self.binance.create_market_order(symbol, side, size)
            order_id = order['id']
            
            # Stop loss
            stop_order = self.binance.create_order(
                symbol, 'stop_market', 'sell' if side=='buy' else 'buy',
                size, None, params={'stopPrice': stop_loss}
            )
            
            # Take profit
            target_order = self.binance.create_order(
                symbol, 'take_profit_market', 'sell' if side=='buy' else 'buy',
                size, None, params={'stopPrice': target}
            )
            
            self.open_orders[order_id] = {
                'symbol': symbol, 'side': side, 'size': size,
                'entry': price, 'stop': stop_loss, 'target': target,
                'status': 'open'
            }
            
            print(f"✅ {side.upper()} {symbol} | Size: ${size_usd:.0f} | Stop: {stop_loss} | Target: {target}")
            return order
            
        except Exception as e:
            print(f"❌ Order failed: {e}")
            return None
    
    def check_positions(self):
        """Monitora posições abertas + trailing stop"""
        for order_id, pos in list(self.open_orders.items()):
            try:
                order = self.binance.fetch_order(order_id, pos['symbol'])
                if order['status'] in ['closed', 'canceled']:
                    self.close_position(order_id)
            except:
                pass
    
    def close_position(self, order_id):
        """Calcula PnL + cleanup"""
        del self.open_orders[order_id]
    
    def simulate_slippage(self, symbol, size_usd):
        """Slippage realista 0.05-0.2%"""
        orderbook = self.binance.fetch_order_book(symbol)
        spread_pct = ((orderbook['asks'][0][0] - orderbook['bids'][0][0]) / 
                     orderbook['bids'][0][0])
