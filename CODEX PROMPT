def init_database(self):
    """Cria 5 tabelas production + índices críticos"""
    conn = sqlite3.connect(self.db_path)
    cursor = conn.cursor()
    
    # 1. TRADES (histórico completo)
    cursor.execute('''
    CREATE TABLE IF NOT EXISTS trades (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        timestamp DATETIME DEFAULT CURRENT_TIMESTAMP,
        symbol TEXT NOT NULL,
        side TEXT NOT NULL,
        entry_price REAL,
        exit_price REAL,
        size_usd REAL,
        pnl_usd REAL,
        pnl_pct REAL,
        duration_min INTEGER,
        reason TEXT,
        model_votes TEXT,  -- JSON string
        regime TEXT,
        confidence REAL,
        slippage_pct REAL,
        features_hash TEXT
    )
    ''')
    
    # 2. METRICS (agregados diários/semanais)
    cursor.execute('''
    CREATE TABLE IF NOT EXISTS metrics (
        date DATE,
        period TEXT,  -- '1D', '1W', '1M'
        sharpe REAL,
        sortino REAL,
        calmar REAL,
        profit_factor REAL,
        winrate_pct REAL,
        max_dd_pct REAL,
        trades_count INTEGER,
        avg_hold_min REAL,
        PRIMARY KEY (date, period)
    )
    ''')
    
    # 3. RL_EPISODES (PPO replay buffer)
    cursor.execute('''
    CREATE TABLE IF NOT EXISTS rl_episodes (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        timestamp DATETIME DEFAULT CURRENT_TIMESTAMP,
        state_features TEXT,  -- JSON comprimido
        action TEXT,
        reward REAL,
        next_state TEXT,
        done BOOLEAN
    )
    ''')
    
    # 4. NEWS_IMPACT (sentiment histórico)
    cursor.execute('''
